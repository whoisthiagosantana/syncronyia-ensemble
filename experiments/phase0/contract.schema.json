{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:syncronyia:ensemble:proposal:v1alpha1",
  "title": "Offline synthetic proposal contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "work_item_id",
    "repository_sha",
    "snapshot_sha256",
    "route",
    "engine",
    "state",
    "tasks",
    "assumptions",
    "open_decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "EnsembleProposal/v1alpha1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
    },
    "repository_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "route": {
      "const": "TASK_SPEC"
    },
    "engine": {
      "const": "ensemble"
    },
    "state": {
      "const": "proposed"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "summary",
          "paths",
          "depends_on",
          "evidence_refs"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 32
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
            },
            "uniqueItems": true,
            "maxItems": 32
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
            },
            "uniqueItems": true,
            "maxItems": 32,
            "minItems": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 280
      }
    },
    "open_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
      },
      "uniqueItems": true,
      "maxItems": 32
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "work_item_id",
        "repository_sha",
        "route",
        "engine",
        "allowed_task_ids",
        "allowed_paths",
        "allowed_dependency_ids",
        "allowed_evidence_ids",
        "required_decision_ids"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
        },
        "work_item_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
        },
        "repository_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "route": {
          "const": "TASK_SPEC"
        },
        "engine": {
          "const": "ensemble"
        },
        "allowed_task_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
          },
          "uniqueItems": true,
          "maxItems": 32,
          "minItems": 1
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 32
        },
        "allowed_dependency_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
          },
          "uniqueItems": true,
          "maxItems": 32
        },
        "allowed_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
          },
          "uniqueItems": true,
          "maxItems": 32,
          "minItems": 1
        },
        "required_decision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
          },
          "uniqueItems": true,
          "maxItems": 32
        }
      }
    }
  }
}
